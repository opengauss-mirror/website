{
  "name": "opengauss",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "pnpm gen:blogs && pnpm gen:news && vitepress dev app",
    "build": "pnpm gen:blogs && pnpm gen:news && vitepress build app",
    "test:e2e": "playwright test && playwright show-report",
    "test:unit": "vitest",
    "lint": "eslint \"app/.vitepress/src/**/*.{js,ts,vue,jsx,tsx}\"",
    "fix": "eslint --fix \"app/.vitepress/src/**/*.{js,ts,vue,jsx,tsx}\"",
    "lint:components": "eslint \"opendesign/**/*.{js,ts,vue,jsx,tsx}\"",
    "prepare": "husky install",
    "gen:blogs": "node scripts/index.js blogs",
    "gen:news": "node scripts/index.js news"
  },
  "keywords": [],
  "author": "",
  "license": "",
  "dependencies": {
    "@opensig/open-analytics": "^0.0.9",
    "@opensig/opendesign": "0.0.75",
    "@vueuse/core": "10.11.1",
    "axios": "1.12.0",
    "clipboard": "2.0.11",
    "dayjs": "1.11.13",
    "element-plus": "2.8.2",
    "highlight.js": "11.9.0",
    "js-cookie": "3.0.5",
    "opendesign": "./opendesign",
    "pinia": "2.0.13",
    "uuid": "10.0.0",
    "vue": "3.3.4",
    "vue-dompurify-html": "3.1.2",
    "vue-i18n": "9.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@rushstack/eslint-patch": "^1.10.5",
    "@types/node": "20.5.9",
    "@vitejs/plugin-vue-jsx": "2.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "12.0.0",
    "eslint": "8.56.0",
    "husky": "8.0.3",
    "js-yaml": "4.1.0",
    "jsdom": "25.0.1",
    "prettier": "3.2.5",
    "sass": "1.62.0",
    "typescript": "4.9.4",
    "unplugin-icons": "0.17.1",
    "vite-plugin-static-copy": "^2.2.0",
    "vitepress": "1.2.3",
    "vitest": "2.1.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search"
      ]
    }
  }
}
