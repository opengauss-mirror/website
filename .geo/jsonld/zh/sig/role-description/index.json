          "@type": "ListItem",
          "position": 1,
          "item": {
            "@type": "Thing",
            "name": "贡献者 Contributor",
            "description": "贡献者是openGauss社区的核心力量，他们通过代码开发、文档完善、问题修复、社区运营等多种方式积极参与，共同推动项目的创新与发展。",
            "url": "https://opengauss.org/zh/sig/role-description/#contributor"
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": {
            "@type": "Thing",
            "name": "审核者 Committer",
            "description": "审核者是代码仓库的核心维护者，拥有代码合入权限。他们凭借丰富的技术经验，通过代码评审、开发者测试和规范检查等方式保障代码质量，并推动数据库的技术演进与长期健康发展。",
            "url": "https://opengauss.org/zh/sig/role-description/#committer"
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "item": {
            "@type": "Thing",
            "name": "维护者 Maintainer",
            "description": "维护者是SIG组的核心领导者，负责技术方向规划、社区协作和长期发展。他们不仅具备审核者的所有职责，还主导组件的架构演进、质量保障和生态适配，并通过协调社区内外资源推动SIG目标的实现。",
            "url": "https://opengauss.org/zh/sig/role-description/#maintainer"
          }
        }
      ]
